# git-wiki environment configuration — EXAMPLE / TEMPLATE
#
# Copy to `.env` for local dev (`.env` is git-ignored). In production these come
# from Kubernetes ConfigMaps (non-secret) and Secrets (secret) — never commit
# real secrets. Authoritative reference: docs/specs/configuration.md.
#
# Values marked (required in production) MUST be set explicitly when
# NODE_ENV=production; the server refuses to start otherwise (fail-fast).

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Backend HTTP port.
PORT=3000
# Directory of the built client bundle served statically in production.
# (Server-runtime path; not a spec var. Consumed by server/src/index.ts.)
CLIENT_DIST=client/dist
# Who may read docs: PUBLIC or AUTHENTICATED.
READ_ACCESS=AUTHENTICATED

# ── SSO session verification (required in production — ADR-0005) ─────────────
# The wiki holds NO signing key; it only verifies JWTs against the SSO JWKS.
SSO_JWKS_URL=https://sso.prod.tapestry.app/.well-known/jwks.json
SSO_ISSUER=https://sso.prod.tapestry.app
SSO_AUDIENCE=wiki.prod.tapestry.app
# Name of the shared cookie SSO sets on Domain=prod.tapestry.app.
SESSION_COOKIE_NAME=tapestry_session
SSO_LOGOUT_URL=https://sso.prod.tapestry.app/logout

# ── Docs repo & sync ─────────────────────────────────────────────────────────
# Remote git URL cloned into REPO_CACHE_DIR (required in production).
DOCS_REPO_URL=https://github.com/your-org/your-docs.git
DOCS_REPO_BRANCH=main
REPO_CACHE_DIR=./repo-cache
# Background pull interval in seconds; 0 disables polling.
SYNC_POLL_INTERVAL=300
# Comma-separated usernames/emails permitted to write (v1). Empty = rely on
# PR-mode repo perms / SSO-supplied roles.
EDIT_ALLOWLIST=

# ── Git machine credential (SECRET, required in production) ───────────────────
# GitHub App used for ALL clone/pull/push against the docs repo (not per-user).
# In k8s these come from Kubernetes Secrets mounted as env vars.
DOCS_GIT_APP_ID=
DOCS_GIT_APP_PRIVATE_KEY=
DOCS_GIT_APP_INSTALLATION_ID=

# ── Dev/test auth (local only; ignored when NODE_ENV=production) ──────────────
# Enables POST /api/auth/dev. Hard-forced OFF in production.
AUTH_DEV_MODE=false
DEV_AUTH_USERNAME=
DEV_AUTH_PASSWORD=
# Local key used to sign/verify the dev session JWT (never committed).
DEV_JWT_SIGNING_KEY=
# Git author identity for dev-mode commits.
DEV_AUTH_NAME=dev
DEV_AUTH_EMAIL=dev@localhost

# ── Rendering / embeds ───────────────────────────────────────────────────────
# Host allowlist for iframe src and CSP frame-src (comma-separated).
IFRAME_ALLOWED_HOSTS=youtube-nocookie.com,youtube.com,codesandbox.io
