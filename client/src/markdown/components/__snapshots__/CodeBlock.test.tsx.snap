<span></span><span class="token" style="color: rgb(86, 156, 214);">export</span><span> </span><span class="token" style="color: rgb(86, 156, 214);">function</span><span> </span><span class="token" style="color: rgb(220, 220, 170);">labelFor</span><span class="token" style="color: rgb(212, 212, 212);">(</span><span>node</span><span class="token" style="color: rgb(212, 212, 212);">:</span><span> TreeNode</span><span class="token" style="color: rgb(212, 212, 212);">)</span><span class="token" style="color: rgb(212, 212, 212);">:</span><span> </span><span class="token" style="color: rgb(206, 145, 120);">string</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">{</span><span>
