{
  "name": "@wiki/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frozen shared API contract types for git-wiki (types + route constants; no runtime deps).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build"
  }
}
